# =============================================================================
# Sense.AI / newsScrapper — complete deployment configuration
# =============================================================================
# Copy this file to ".env" in the same folder as main.py.
# Never commit the real .env file. The repository ignores it.
# Use one KEY=value setting per line. Do not add spaces around "=".
# Windows paths may use C:\folder\file. Quotes are normally unnecessary.

# --- Runtime mode and security ------------------------------------------------
# Use "development" only on a developer PC. Use "production" on App_Portable.
NEWSSCRAPPER_ENV=production
# Approval/export administration key. Production requires at least 6 characters.
DIRECTOR_KEY=change-director-key
# Analytics page key. Production requires at least 6 characters.
ANALYTICS_KEY=change-analytics-key
# Gatekeeper review key. Production requires at least 6 characters.
GATEKEEPER_KEY=change-gatekeeper-key
# Internal contributions editor key (Review Queue > Contributions). Falls back
# to GATEKEEPER_KEY, then DIRECTOR_KEY, then the development default "1357".
# Production requires at least 6 characters.
INTERNAL_EDITOR_KEY=change-internal-editor-key
# Stable secret used to HMAC-like hash viewer IP identities. Never change it
# after launch or existing users will appear to be new users.
# Generate one in PowerShell:
#   [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(32)).ToLower()
NEWSSCRAPPER_IP_HASH_SECRET=replace-with-generated-64-character-secret
# Separate signing secret for the private browser-scoped For You identity.
# Generate it with the same PowerShell command as the IP secret, but use a
# different value. Changing it signs every browser out of its private mix.
NEWSSCRAPPER_VIEWER_COOKIE_SECRET=replace-with-a-different-generated-64-character-secret
# auto adds Secure only when the browser reached the server over HTTPS. This is
# required for the current plain-HTTP LAN pilot; set true after HTTPS rollout.
NEWSSCRAPPER_VIEWER_COOKIE_SECURE=auto
# Leave blank when the Vite proxy or FastAPI serves the UI (recommended). Add
# only explicit trusted browser origins when a separately hosted UI is truly
# required; never use "*" for private viewer APIs.
NEWSSCRAPPER_CORS_ALLOWED_ORIGINS=

# --- Retired profile routing and privileged screens --------------------------
# Retained only for rollback compatibility. Unified serving ignores this list.
BROADCAST_SPECIAL_IPS=
# Comma-separated IPs allowed to unlock analytics.
ANALYTICS_ALLOWED_IPS=127.0.0.1,::1
# Comma-separated IPs allowed to open Gatekeeper review.
GATEKEEPER_ALLOWED_IPS=127.0.0.1,::1
# Comma-separated IPs allowed to see and use the private Contributions
# workspace. This controls authoring only: published Samsung Internal stories
# remain readable by ordinary users and editorial review keeps its editor key.
# When this line is absent, only the server's own loopback addresses are
# allowed. Add each approved contributor's real LAN address explicitly.
CONTRIBUTIONS_ALLOWED_IPS=127.0.0.1,::1
# Retained only for an explicit legacy-routing rollback.
PROFILE_SETTINGS_ALLOWED_IPS=127.0.0.1,::1
# IPs allowed to see sensitive service diagnostics in /status.
SYSTEM_STATUS_ALLOWED_IPS=127.0.0.1,::1
# Only list reverse proxies that you control. X-Forwarded-For is ignored from
# every other peer. For direct LAN hosting, loopback values are sufficient.
TRUSTED_PROXY_IPS=127.0.0.1,::1
# Optional IP:name entries used by analytics, separated by commas.
TEAM_IP_MAP=192.0.2.10:Example User

# --- Scheduler, retention, and crawler ---------------------------------------
# true starts the autonomous scheduler when Uvicorn starts.
SCHEDULER_ENABLED=true
# Seconds before retrying a failed unified run or a run deferred by a manual scan.
SCHEDULER_RETRY_DELAY_SECONDS=600
# Keep ordinary briefing history for 30 days. Saved-for-later is separate.
HISTORY_RETENTION_DAYS=30
# 1 means today only; 2 means today and yesterday.
CRAWL_LOOKBACK_DAYS=1
# Respect each publisher's robots.txt rules.
SCRAPY_ROBOTSTXT_OBEY=true

# --- Explainable For You experience ------------------------------------------
# For You is the standard landing experience. Set either switch to false only
# for an intentional rollback; the shared Briefing always remains available.
FOR_YOU_ENABLED=true
# true sends the root NewsScrapper route to /for-you.
FOR_YOU_DEFAULT_LANDING=true
# true displays grounded 18-35 word AI context. Invalid Chat output is rejected
# and a factual local summary sentence is used when evidence is sufficient.
FOR_YOU_HOOKS_ENABLED=true
# Reserved opt-in for MiniLM viewer-affinity scoring. V1 exact, explainable
# taxonomy scoring remains active while this is false.
FOR_YOU_SEMANTIC_AFFINITY_ENABLED=false
# Passive recommendation events are sent in small idempotent batches.
FOR_YOU_EVENT_BATCH_SIZE=10
FOR_YOU_EVENT_FLUSH_SECONDS=15
# Percentage of the first page reserved for explained useful surprise (0-50).
FOR_YOU_EXPLORATION_PERCENT=15
# false is the production setting: every viewer uses one shared corpus and
# broadcast is an interest/filter, not an IP profile.
LEGACY_PROFILE_ROUTING_ENABLED=false
# Retained for rollback parsing. Unified serving always includes broadcast
# candidates and ranks them according to each viewer's preferences/behavior.
BROADCAST_VISIBILITY_MODE=interest

# --- Unified corpus ----------------------------------------------------------
# Optional legacy parity artifacts; not used by the serving feed.
UNIFIED_CORPUS_SHADOW_ENABLED=false
# One sites.json, one scheduler crawl, one briefing history, one training JSON,
# and one bouncer pickle. Keep this true for the production architecture.
UNIFIED_CORPUS_ENABLED=true
# JSON state and the scheduler are single-worker only. Run exactly one Uvicorn
# worker until a transactional database and distributed lock are introduced.

# --- Local model locations ----------------------------------------------------
# Preferred parent folder for all Hugging Face models.
SENSE_MODEL_ROOT=C:\App_Portable\model_weights
# true prevents accidental Hugging Face network downloads at runtime.
SENSE_OFFLINE_ONLY=true

# --- Mutable application data ------------------------------------------------
# News history, profiles, votes, workflow, caches, and trained bouncer files.
NEWSSCRAPPER_RUNTIME_DIR=C:\App_Portable\news_scrapper\runtime
# Venture Lens cache, watchlists, and snapshots.
VENTURE_LENS_RUNTIME_DIR=C:\App_Portable\venture_lens\runtime
# Optional explicit built Vite path. When blank/omitted, the backend detects
# news-ui\dist in a source checkout or frontend\dist in App_Portable.
NEWSSCRAPPER_FRONTEND_DIST=

# --- Secure TLS and company certificates -------------------------------------
# true asks Python Requests to use the Windows system certificate store.
NEWSSCRAPPER_USE_SYSTEM_CA=true
# Optional PEM bundle supplied by company IT. Leave blank when system CA works.
REQUESTS_CA_BUNDLE=
# Optional global Python/OpenSSL PEM bundle; normally the same file as above.
SSL_CERT_FILE=
# Optional service-specific PEM bundles. These override the global bundle.
SAMSUNG_WEB_SEARCH_CA_BUNDLE=
SAMSUNG_CHAT_CA_BUNDLE=
ARTICLE_IMAGE_METADATA_CA_BUNDLE=
# Verification cannot be disabled by these values; false is deliberately
# ignored by the application. Keep all three true.
SAMSUNG_WEB_SEARCH_VERIFY_SSL=true
SAMSUNG_CHAT_VERIFY_SSL=true
ARTICLE_IMAGE_METADATA_VERIFY_SSL=true

# --- Samsung pipeline master switch ------------------------------------------
# true enables preflight checks and prefers Samsung services when healthy.
# If a service fails, logs explain the failure and local fallbacks are selected.
SAMSUNG_PIPELINE_ENABLED=true
# When Web Search passes preflight, Scrapy discovers URLs without downloading
# full article bodies. Python still enforces exact URL/domain matching.
SAMSUNG_DISCOVERY_ONLY=true
# Cached successful Samsung results retained in runtime storage.
SAMSUNG_CACHE_MAX_ITEMS=2500
# Reuse health results for this many seconds before probing again.
SAMSUNG_HEALTH_CACHE_SECONDS=900

# --- Samsung Web Search: primary article extraction ---------------------------
# Full company-internal Web Search OpenAPI route. Obtain it from the internal
# service documentation; endpoint hostnames do not belong in a public repo.
SAMSUNG_WEB_SEARCH_URL=
# Legacy alias read only when SAMSUNG_WEB_SEARCH_URL is empty. Keep blank.
SAMSUNG_WEB_SEARCH_ENDPOINT=
# Paste the active x-generative-ai-client value after "=".
SAMSUNG_WEB_SEARCH_CLIENT=
# Paste the active x-openapi-token value after "=". Include "Bearer " only if
# the issued credential itself requires it; the adapter preserves your value.
SAMSUNG_WEB_SEARCH_TOKEN=
# Maximum seconds for one Web Search call.
SAMSUNG_WEB_SEARCH_TIMEOUT=90
# Maximum seconds for exact-URL page completion when a reference lacks content.
SAMSUNG_WEB_SEARCH_ARTICLE_FETCH_TIMEOUT=30
# Hard service quota. Values above 3 are clamped to 3 by the application.
SAMSUNG_WEB_SEARCH_REQUESTS_PER_MINUTE=3
# Print sanitized payload diagnostics without printing credentials.
SAMSUNG_WEB_SEARCH_DEBUG=false
# Enables Web Search enrichment. Master Samsung switch also enables it.
WEB_SEARCH_ENRICHMENT_ENABLED=true
# Reject enriched text that does not match profile keywords.
WEB_SEARCH_REQUIRE_KEYWORD_MATCH=true
# 0 means enrich every discovered article; positive values cap each run.
WEB_SEARCH_MAX_ENRICH_PER_RUN=0
# Optional extra delay after each call; quota pacing already enforces 3/minute.
WEB_SEARCH_ENRICH_DELAY_SECONDS=0
# true rejects an article when Samsung extraction fails. In automatic preflight
# fallback mode, Scrapy full extraction is used when Web Search is unavailable.
WEB_SEARCH_REQUIRE_SUCCESS=true

# --- Samsung Chat: primary summary, intent, and Why This Matters --------------
# Full company-internal messages route. Do not use the shorter product base URL.
SAMSUNG_CHAT_URL=
# Paste the active x-generative-ai-client value after "=".
SAMSUNG_CHAT_CLIENT=
# Paste the active x-openapi-token value after "=".
SAMSUNG_CHAT_TOKEN=
# Model identifier supplied as the single entry in modelIds.
SAMSUNG_CHAT_MODEL_ID=
# Maximum seconds for one Chat request.
SAMSUNG_CHAT_TIMEOUT=180
# Hard service quota. Values above 3 are clamped to 3 by the application.
SAMSUNG_CHAT_REQUESTS_PER_MINUTE=3
# Chat is primary when healthy; local BART/FLAN-T5 is the automatic fallback.
FINAL_CHAT_SUMMARY_ENABLED=true
# Optional additional delay; normal quota pacing already limits calls.
FINAL_CHAT_SUMMARY_DELAY_SECONDS=0
# 0 means summarize every final cluster; positive values cap each run.
FINAL_CHAT_SUMMARY_MAX_ARTICLES=0

# --- Private English -> Korean interface translation -------------------------
# true enables the per-browser Korean language control in NewsScrapper.
KOREAN_TRANSLATION_ENABLED=true
# Official Hugging Face model used for English-to-Korean neural translation.
KOREAN_TRANSLATION_MODEL_ID=Helsinki-NLP/opus-mt-tc-big-en-ko
# The downloaded model folder. Copy this folder with App_Portable; model files
# are intentionally not committed to GitHub.
KOREAN_TRANSLATION_MODEL_PATH=C:\App_Portable\model_weights\opus-mt-tc-big-en-ko
# true guarantees that production never downloads a model from the internet.
KOREAN_TRANSLATION_LOCAL_ONLY=true
# auto selects CUDA when available and otherwise uses CPU. Use cpu if the
# server GPU/driver is not configured for PyTorch.
KOREAN_TRANSLATION_DEVICE=auto
# Safety limits for one browser batching DOM text. These do not abbreviate or
# summarize text; longer prose is split and translated in full.
KOREAN_TRANSLATION_MAX_ITEMS=100
KOREAN_TRANSLATION_MAX_TEXT_CHARS=20000
# Number of translated strings retained in process memory for fast reuse.
KOREAN_TRANSLATION_CACHE_SIZE=5000
# Local inference tuning. Length-sorted batches of eight strings and greedy
# decoding keep CPU translation responsive for the live interface.
KOREAN_TRANSLATION_BATCH_SIZE=8
# Greedy decoding is substantially faster for live UI translation. Set 2 only
# if you prefer a slower, marginally more exploratory translation pass.
KOREAN_TRANSLATION_NUM_BEAMS=1

# --- Article image metadata ---------------------------------------------------
# Extract OpenGraph/Twitter images when the article has no usable image.
ARTICLE_IMAGE_METADATA_ENABLED=true
# Maximum seconds for one metadata request.
ARTICLE_IMAGE_METADATA_TIMEOUT=12

# --- Private URL briefings ----------------------------------------------------
# Maximum URLs one viewer may submit in a single My Briefing request.
PERSONAL_BRIEFING_MAX_URLS=20
# Timeout for the secure exact-URL fallback when Web Search is unavailable.
PERSONAL_BRIEFING_FETCH_TIMEOUT=30
# Maximum HTML response size accepted by the fallback extractor (5 MB).
PERSONAL_BRIEFING_MAX_BYTES=5000000

# --- Venture Lens -------------------------------------------------------------
# Optional GitHub personal access token. Public data works without it but is
# rate-limited more aggressively by GitHub.
GITHUB_TOKEN=
# Optional OpenAlex key. Scholarly discovery remains available without it;
# adding an issued key is recommended for higher-volume deployments.
OPENALEX_API_KEY=
# Optional Hugging Face Hub read token. Public model and dataset discovery works
# while blank; use a read-only token if your organization needs higher limits.
HUGGINGFACE_TOKEN=
# Optional EPO Open Patent Services OAuth credentials. Both values are required
# before the Patents lane is displayed. Leave both blank to hide that lane.
EPO_OPS_CLIENT_ID=
EPO_OPS_CLIENT_SECRET=
# Optional X API bearer token. X can annotate the evidence stream only; it is
# never used as the sole evidence for a featured research artifact.
X_BEARER_TOKEN=

# --- Frontend API routing -----------------------------------------------------
# Keep both values blank. Vite proxies same-origin paths to port 8000 during
# development, and the production bundle talks to the FastAPI server that
# served it. A hard-coded localhost value would point at each viewer's own PC.
VITE_API_BASE=
# Compatibility alias used by one legacy feedback component; keep it blank too.
VITE_API_BASE_URL=
